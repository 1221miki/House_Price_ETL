# Environments & Secrets
.env
*.env
!.env.example

# Large Data Files (Ignore all Parquet files > 100MB and zip archives)
*.zip
Data/**/*.parquet
data/**/*.parquet
Data/*.parquet
data/*.parquet
*.parquet

# Whitelist small test sample files (< 2MB) for instant repo cloning & demos
!data/samples/*.parquet
!Data/samples/*.parquet

# Processed & Temporary data
data/processed/*
!data/processed/.gitkeep

# Logs
logs/
*.log

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.pyc

# IDE & OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db
